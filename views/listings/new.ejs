<% layout('/layouts/boilerplate.ejs') %>

    <body>
       
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <form action="/listings" method="POST" novalidate class="needs-validation"  enctype="multipart/form-data" >
                     <h3>Create New Listing</h3>
                    <div class="mb-3">
                        <label for="title" class="form-label">Title:</label>
                        <input type="text" id="title" name="title" required placeholder="Enter title"
                            class="form-control">
                            <div class="valid-feedback">Looks good!</div>
                            <div class="invalid-feedback">Please enter a title.</div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description:</label>
                        <textarea id="description" name="description" required placeholder="Enter description"
                            class="form-control"></textarea>
                            <div class="valid-feedback">Good Description!</div>
                            <div class="invalid-feedback">Please enter a short description.</div>
                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-label">Uplod Listing Image:</label>
                        <input type="file" id="image" name="image[url]" required class="form-control">
                        <div class="valid-feedback">Good image!</div>
                        <div class="invalid-feedback">Please Upload an image.</div>
                    </div>
                    <div class="row">

                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-label">Price:</label>
                            <input type="number" id="price" name="price" step="0.01" required placeholder="Enter price"
                                class="form-control">
                                <div class="valid-feedback">Good price!</div>
                                <div class="invalid-feedback">Please enter a price.</div>
                        </div>
                        <div class="mb-3 col-md-8">
                            <label for="location" class="form-label">Location:</label>
                            <input type="text" id="location" name="location" required placeholder="Enter location"
                                class="form-control">
                                <div class="valid-feedback">Good location!</div>
                                <div class="invalid-feedback">Please enter a location.</div>
                        </div>

                    </div>
                    <div class="mb-3">
                        <label for="country" class="form-label">Country:</label>
                        <input type="text" id="country" name="country" required placeholder="Enter country"
                            class="form-control">
                            <div class="valid-feedback">Good country!</div>
                            <div class="invalid-feedback">Please enter a country.</div>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-primary">ADD Listing</button>
                    </div>
                </form>
            </div>
        </div>
    </body>